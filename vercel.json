{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "regions": ["iad1"],
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/tmdb/t/p/:path*",
            "destination": "https://image.tmdb.org/t/p/:path*"
        },
        {
            "source": "/tmdb/t/:type/:path*",
            "destination": "https://image.tmdb.org/t/:type/:path*"
        },
        {
            "source": "/tmdb/3/:path*",
            "destination": "/api/tmdb.js"
        },
        {
            "source": "/tmdb/4/:path*",
            "destination": "/api/tmdb.js"
        },
        {
            "source": "/pi/api/models/revisions/:path*",
            "destination": "https://pi.dev/api/models/revisions/:path*"
        },
        {
            "source": "/health",
            "destination": "/api/tmdb.js"
        },
        {
            "source": "/",
            "destination": "/api/tmdb.js"
        },
        {
            "source": "/:path*",
            "destination": "/api/tmdb.js"
        }
    ],
    "headers": [
        {
            "source": "/pi/:path*",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cross-Origin-Resource-Policy",
                    "value": "cross-origin"
                }
            ]
        }
    ]
}
